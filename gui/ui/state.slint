import { ItemRow, PairRow, WizardRow, Cells, BlockGeom, Segment, FieldSpec, CardInfo } from "theme.slint";

// Shell state: navigation, project, status line.
export global AppState {
    in-out property <string> screen: "start";
    in-out property <string> project-name: "Untitled project";
    in-out property <string> project-path: "reliakit_project.json";
    in property <string> status: "Ready.";
    in property <string> headline: "";
    in property <[ItemRow]> items;
    in property <int> selected-index: -1;
    in property <string> current-title: "Start page";
    in-out property <int> kind-index: 0;
    in-out property <string> new-name: "";
    in-out property <string> rename-name: "";
    in property <[[CardInfo]]> example-rows;
    in property <[[CardInfo]]> dataset-rows;
    in-out property <bool> about-open: false;
    in property <int> item-count: 0;
}

// All user actions funnel through these callbacks; the Rust side
// pulls field values from the globals, runs the work, pushes back.
export global Actions {
    callback go-start();
    callback select-item(int);
    callback add-item();
    callback remove-item();
    callback rename-item();
    callback new-project();
    callback save-project();
    callback open-project();
    callback card-action(string);
    callback act(string);
    callback row-act(string, int);
    callback field-changed(string, string);
    callback csv-bundled();
    callback csv-file();
    callback rbd-arm(string);
    callback rbd-place(float, float);
    callback rbd-press(int);
    callback rbd-drag(int, float, float);
    callback rbd-release(int);
}

// Shared CSV import controls (bundled dataset picker + file path).
export global CsvUi {
    in property <[string]> files;
    in-out property <int> pick-index: 10;
    in-out property <string> path: "";
}

export global LifeUi {
    in-out property <string> times: "";
    in-out property <int> dist-index: 0;
    in-out property <bool> rank: false;
    in-out property <string> t: "1000";
    in-out property <bool> show-prob: false;
    in property <[PairRow]> results;
    in property <image> chart;
    in property <bool> has-chart: false;
    in property <string> chart-title: "Reliability curve";
    in property <string> headline-value: "";
    in property <[WizardRow]> wizard-rows;
    in property <string> wizard-note: "";
    in property <bool> has-fit: false;
    in property <[string]> rbd-targets;
    in-out property <int> target-index: 0;
    in property <[string]> block-names;
    in-out property <int> block-index: 0;
}

