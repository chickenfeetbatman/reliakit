import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";

import { Theme, CardInfo } from "theme.slint";
import { AppState, Actions } from "state.slint";
import { PrimaryButton, GhostButton, SectionTitle, Caption } from "components.slint";
import { LifeScreen, LimitedScreen, McmcScreen } from "screens_a.slint";
import { DegradationScreen, AltScreen, GrowthScreen, CompetingScreen } from "screens_b.slint";
import { RbdScreen, FaultTreeScreen } from "screens_c.slint";
import { FmeaScreen, WarrantyScreen, RcmScreen, FracasScreen } from "screens_d.slint";
import { PredictionScreen, DoeScreen, FlowchartScreen, MarkovScreen, QcpScreen } from "screens_e.slint";
import { LineEdit, ComboBox, ScrollView, ListView, AboutSlint, Palette } from "std-widgets.slint";

export { Theme, AppState, Actions }
export { LifeUi, LimitedUi, McmcUi, DegUi, AltUi, GrowthUi, CompUi, RbdUi, FtUi, FmeaUi, WarUi, PredUi, DoeUi, FlowUi, MarkovUi, QcpUi, RcmUi, FracasUi, CsvUi } from "state.slint";

component StartCard inherits Rectangle {
    in property <CardInfo> card;
    height: 96px;
    background: ta.has-hover ? Theme.card-raised : Theme.card;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border-soft;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding: 13px;
        spacing: 11px;
        Image {
            source: root.card.icon;
            width: 22px;
            height: 22px;
            colorize: Theme.tint;
        }
        VerticalLayout {
            spacing: 3px;
            alignment: start;
            Text {
                text: root.card.tag;
                font-family: Theme.font;
                font-size: 10.5px;
                font-weight: 600;
                color: Theme.tint;
            }
            Text {
                text: root.card.title;
                font-family: Theme.font;
                font-size: 13.5px;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
                overflow: elide;
            }
            Text {
                text: root.card.sub;
                font-family: Theme.font;
                font-size: 11.5px;
                color: Theme.muted;
                wrap: word-wrap;
                overflow: elide;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Actions.card-action(root.card.action-id); }
    }
}

component StartPage inherits ScrollView {
    VerticalLayout {
        padding: 28px;
        spacing: 22px;
        alignment: start;
        Rectangle {
            background: Theme.card;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border-soft;
            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 16px;
                    Image {
                        source: @image-url("logo.svg");
                        width: 58px;
                        height: 58px;
                    }
                    VerticalLayout {
                        spacing: 3px;
                        alignment: center;
                        Text {
                            text: "ReliaKit";
                            font-family: Theme.font;
                            font-size: Theme.fs-large;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        Text {
                            text: "One project workspace. Each item holds its own analysis, and items send results to each other.";
                            font-family: Theme.font;
                            font-size: Theme.fs-body;
                            color: Theme.muted;
                        }
                    }
                }
                Image {
                    source: @image-url("hero.svg");
                    width: 100%;
                    height: 148px;
                    image-fit: contain;
                }
            }
        }
        HorizontalLayout {
            spacing: 14px;
            Rectangle {
                background: Theme.card;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-soft;
                VerticalLayout {
                    padding: 16px;
                    spacing: 9px;
                    alignment: start;
                    SectionTitle { text: "New project"; }
                    Caption { text: "Start empty, then add analysis items from the project panel."; }
                    PrimaryButton {
                        text: "New project";
                        icon: @image-url("icons/plus.svg");
                        clicked => { Actions.new-project(); }
                    }
                }
            }
            Rectangle {
                background: Theme.card;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-soft;
                VerticalLayout {
                    padding: 16px;
                    spacing: 9px;
                    alignment: start;
                    SectionTitle { text: "Open project"; }
                    Caption { text: "Project file: " + AppState.project-path; }
                    GhostButton {
                        text: "Open project";
                        icon: @image-url("icons/open.svg");
                        clicked => { Actions.open-project(); }
                    }
                }
            }
            Rectangle {
                background: Theme.card;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-soft;
                VerticalLayout {
                    padding: 16px;
                    spacing: 9px;
                    alignment: start;
                    SectionTitle { text: "This project"; }
                    Caption { text: AppState.item-count == 0 ? "No items yet. Load an example or a dataset below, or add an item from the project panel." : AppState.item-count + " items. Click one in the project panel to open it."; }
                    GhostButton {
                        text: "Save project";
                        icon: @image-url("icons/save.svg");
                        clicked => { Actions.save-project(); }
                    }
                }
            }
        }
        VerticalLayout {
            spacing: 10px;
            SectionTitle { text: "Examples"; }
            Caption { text: "Each example loads as a new item in this project."; }
            for row in AppState.example-rows: HorizontalLayout {
                spacing: 14px;
                for c in row: StartCard { card: c; }
            }
        }
        VerticalLayout {
            spacing: 10px;
            SectionTitle { text: "Bundled datasets"; }
            Caption { text: "Documented example datasets from the ReliaSoft documentation and public textbooks, each with its source recorded in datasets/README.md. Life files go to Life Data, ALT files to ALT, degradation files to Degradation, growth files to Growth, and the Nevada warranty file to Warranty."; }
            for row in AppState.dataset-rows: HorizontalLayout {
                spacing: 14px;
                for c in row: StartCard { card: c; }
            }
        }
        Rectangle {
            background: Theme.card;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border-soft;
            VerticalLayout {
                padding: 16px;
                spacing: 6px;
                SectionTitle { text: "About ReliaKit"; }
                Caption { text: "ReliaKit 0.3.0. Reliability engineering suite: life data, Bayesian methods, degradation, ALT, growth, RBD, fault trees, FMEA, warranty, prediction, DOE, Markov, RCM, and FRACAS."; }
                Caption { text: "Desktop interface built with Slint under the Slint Royalty-Free License. Interface font: Inter (SIL Open Font License 1.1). Charts rendered with plotters. ReliaKit itself is MIT licensed."; }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "ReliaKit";
    width: 1600px;
    height: 1000px;
    background: Theme.bg;
    default-font-family: Theme.font;
    default-font-size: 14px;
    init => { Palette.color-scheme = ColorScheme.dark; }

    VerticalLayout {
        spacing: 0;
        // Toolbar
        Rectangle {
            height: 52px;
            background: Theme.toolbar;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                Image {
                    source: @image-url("logo.svg");
                    width: 27px;
                    height: 27px;
                    vertical-alignment: center;
                }
                Text {
                    text: "ReliaKit";
                    font-family: Theme.font;
                    font-size: 17px;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Rectangle { width: 1px; height: 24px; background: Theme.border; }
                GhostButton {
                    text: "New";
                    height: 32px;
                    clicked => { Actions.new-project(); }
                }
                GhostButton {
                    text: "Open";
                    icon: @image-url("icons/open.svg");
                    height: 32px;
                    clicked => { Actions.open-project(); }
                }
                GhostButton {
                    text: "Save";
                    icon: @image-url("icons/save.svg");
                    height: 32px;
                    clicked => { Actions.save-project(); }
                }
                Text {
                    text: AppState.current-title;
                    font-family: Theme.font;
                    font-size: Theme.fs-body;
                    color: Theme.muted;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text {
                    text: "v0.3.0";
                    font-family: Theme.font;
                    font-size: Theme.fs-caption;
                    color: Theme.faint;
                    vertical-alignment: center;
                }
                GhostButton {
                    text: "About";
                    height: 32px;
                    clicked => { AppState.about-open = true; }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        // Body
        HorizontalLayout {
            spacing: 0;
            vertical-stretch: 1;
            // Sidebar (source list)
            Rectangle {
                width: 274px;
                background: Theme.sidebar;
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    Text {
                        text: "PROJECT";
                        font-family: Theme.font;
                        font-size: 11px;
                        font-weight: 700;
                        color: Theme.faint;
                    }
                    LineEdit {
                        height: 32px;
                        text <=> AppState.project-name;
                        font-family: Theme.font;
                        font-size: Theme.fs-body;
                    }
                    Rectangle {
                        border-radius: 8px;
                        height: 40px;
                        background: AppState.screen == "start" ? Theme.tint : (home-ta.has-hover ? Theme.card-raised : transparent);
                        animate background { duration: 120ms; }
                        HorizontalLayout {
                            padding-left: 10px;
                            spacing: 9px;
                            Image {
                                source: @image-url("icons/home.svg");
                                width: 17px;
                                height: 17px;
                                colorize: AppState.screen == "start" ? #FFFFFF : Theme.muted;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Start page";
                                font-family: Theme.font;
                                font-size: 13.5px;
                                font-weight: 500;
                                color: AppState.screen == "start" ? #FFFFFF : Theme.text;
                                vertical-alignment: center;
                            }
                        }
                        home-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Actions.go-start(); }
                        }
                    }
                    Text {
                        text: "ITEMS (" + AppState.item-count + ")";
                        font-family: Theme.font;
                        font-size: 11px;
                        font-weight: 700;
                        color: Theme.faint;
                    }
                    ListView {
                        vertical-stretch: 1;
                        for it[i] in AppState.items: Rectangle {
                            height: 42px;
                            border-radius: 8px;
                            background: i == AppState.selected-index ? Theme.tint : (item-ta.has-hover ? Theme.card-raised : transparent);
                            animate background { duration: 120ms; }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 9px;
                                Image {
                                    source: it.icon;
                                    width: 17px;
                                    height: 17px;
                                    colorize: i == AppState.selected-index ? #FFFFFF : Theme.muted;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    spacing: 0;
                                    alignment: center;
                                    Text {
                                        text: it.name;
                                        font-family: Theme.font;
                                        font-size: 13.5px;
                                        font-weight: 500;
                                        color: i == AppState.selected-index ? #FFFFFF : Theme.text;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: it.kind-label;
                                        font-family: Theme.font;
                                        font-size: 10.5px;
                                        color: i == AppState.selected-index ? #D6E9FF : Theme.faint;
                                        overflow: elide;
                                    }
                                }
                            }
                            item-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { Actions.select-item(i); }
                            }
                        }
                    }
                    if AppState.item-count == 0: Caption {
                        text: "No items yet. Add one below, or load an example from the start page.";
                    }
                    Rectangle { height: 1px; background: Theme.border-soft; }
                    Text {
                        text: "ADD ITEM";
                        font-family: Theme.font;
                        font-size: 11px;
                        font-weight: 700;
                        color: Theme.faint;
                    }
                    ComboBox {
                        height: 32px;
                        model: ["Life Data", "Limited Data", "MCMC", "Degradation", "ALT", "Growth", "Competing Risks", "RBD", "Fault Tree", "FMEA", "Warranty", "Prediction", "DOE", "Flowchart", "Markov", "QCP", "RCM", "FRACAS"];
                        current-index <=> AppState.kind-index;
                    }
                    LineEdit {
                        height: 32px;
                        placeholder-text: "Name (optional)";
                        text <=> AppState.new-name;
                        font-family: Theme.font;
                        font-size: Theme.fs-body;
                    }
                    PrimaryButton {
                        text: "Add item";
                        icon: @image-url("icons/plus.svg");
                        clicked => { Actions.add-item(); }
                    }
                    if AppState.selected-index >= 0: VerticalLayout {
                        spacing: 8px;
                        Rectangle { height: 1px; background: Theme.border-soft; }
                        Text {
                            text: "SELECTED ITEM";
                            font-family: Theme.font;
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.faint;
                        }
                        LineEdit {
                            height: 32px;
                            text <=> AppState.rename-name;
                            font-family: Theme.font;
                            font-size: Theme.fs-body;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            GhostButton {
                                text: "Rename";
                                clicked => { Actions.rename-item(); }
                            }
                            GhostButton {
                                text: "Remove";
                                icon: @image-url("icons/trash.svg");
                                clicked => { Actions.remove-item(); }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border-soft; }
                    Text {
                        text: "PROJECT FILE";
                        font-family: Theme.font;
                        font-size: 11px;
                        font-weight: 700;
                        color: Theme.faint;
                    }
                    LineEdit {
                        height: 32px;
                        text <=> AppState.project-path;
                        font-family: Theme.font;
                        font-size: 12.5px;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        GhostButton {
                            text: "Save";
                            icon: @image-url("icons/save.svg");
                            clicked => { Actions.save-project(); }
                        }
                        GhostButton {
                            text: "Open";
                            icon: @image-url("icons/open.svg");
                            clicked => { Actions.open-project(); }
                        }
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.border-soft; }
            // Content
            Rectangle {
                background: Theme.bg;
                horizontal-stretch: 1;
                if AppState.screen == "start": StartPage { width: 100%; height: 100%; }
                if AppState.screen == "life": LifeScreen { width: 100%; height: 100%; }
                if AppState.screen == "limited": LimitedScreen { width: 100%; height: 100%; }
                if AppState.screen == "mcmc": McmcScreen { width: 100%; height: 100%; }
                if AppState.screen == "degradation": DegradationScreen { width: 100%; height: 100%; }
                if AppState.screen == "alt": AltScreen { width: 100%; height: 100%; }
                if AppState.screen == "growth": GrowthScreen { width: 100%; height: 100%; }
                if AppState.screen == "competing": CompetingScreen { width: 100%; height: 100%; }
                if AppState.screen == "rbd": RbdScreen { width: 100%; height: 100%; }
                if AppState.screen == "faulttree": FaultTreeScreen { width: 100%; height: 100%; }
                if AppState.screen == "fmea": FmeaScreen { width: 100%; height: 100%; }
                if AppState.screen == "warranty": WarrantyScreen { width: 100%; height: 100%; }
                if AppState.screen == "prediction": PredictionScreen { width: 100%; height: 100%; }
                if AppState.screen == "doe": DoeScreen { width: 100%; height: 100%; }
                if AppState.screen == "flowchart": FlowchartScreen { width: 100%; height: 100%; }
                if AppState.screen == "markov": MarkovScreen { width: 100%; height: 100%; }
                if AppState.screen == "qcp": QcpScreen { width: 100%; height: 100%; }
                if AppState.screen == "rcm": RcmScreen { width: 100%; height: 100%; }
                if AppState.screen == "fracas": FracasScreen { width: 100%; height: 100%; }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        // Status bar
        Rectangle {
            height: 30px;
            background: Theme.toolbar;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                Text {
                    text: "Status: " + AppState.status;
                    font-family: Theme.font;
                    font-size: 12.5px;
                    color: Theme.muted;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: AppState.headline;
                    font-family: Theme.font;
                    font-size: 12.5px;
                    font-weight: 600;
                    color: Theme.tint;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
    // About overlay
    if AppState.about-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;
        TouchArea {
            clicked => { AppState.about-open = false; }
        }
        Rectangle {
            width: 480px;
            height: 420px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.card-raised;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 24px;
                spacing: 10px;
                alignment: start;
                HorizontalLayout {
                    spacing: 12px;
                    Image { source: @image-url("logo.svg"); width: 40px; height: 40px; }
                    Text {
                        text: "ReliaKit 0.3.0";
                        font-family: Theme.font;
                        font-size: 22px;
                        font-weight: 700;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                }
                Caption { text: "Reliability engineering suite: life data, limited-data Bayesian methods, degradation, ALT, growth, system RBD with standby, fault trees, FMEA, warranty, prediction, DOE, flowchart, Markov, QCP, RCM, and FRACAS."; }
                Caption { text: "Desktop interface built with Slint, used under the Slint Royalty-Free License (https://slint.dev). ReliaKit is MIT licensed."; }
                Caption { text: "Interface font: Inter by Rasmus Andersson, SIL Open Font License 1.1. Charts rendered with the plotters crate (MIT). No proprietary data is bundled; the MIL-HDBK-217F library is a public US government document."; }
                AboutSlint { }
                PrimaryButton {
                    text: "Close";
                    clicked => { AppState.about-open = false; }
                }
            }
        }
    }
}
