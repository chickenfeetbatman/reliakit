import { Theme, PairRow, WizardRow } from "theme.slint";
import { Actions, LifeUi, LimitedUi, McmcUi } from "state.slint";
import { PrimaryButton, GhostButton, SectionTitle, Caption, Field, ComboField, CheckField, TextAreaField, ResultCards, ResultCard, HeadlineCard, LeftPanel, CenterPanel, RightPanel, ScreenTitle, CsvImport, ChartCard } from "components.slint";
import { ScrollView, ListView } from "std-widgets.slint";

export component LifeScreen inherits HorizontalLayout {
    spacing: 0;
    LeftPanel {
        ScreenTitle { title: "Life Data"; sub: "Fit a life distribution to failure and suspension times."; }
        TextAreaField {
            label: "Times (comma separated; suffix c or + = censored)";
            value <=> LifeUi.times;
            rows: 5;
        }
        ComboField {
            label: "Distribution";
            options: ["weibull2", "weibull3", "lognormal", "normal", "exponential", "gamma", "gumbel", "loglogistic", "logistic", "gompertz", "gengamma", "weibull1", "exponential2", "mixed_weibull"];
            index <=> LifeUi.dist-index;
            field-width: 264px;
        }
        HorizontalLayout {
            spacing: 10px;
            Field { label: "Mission t"; value <=> LifeUi.t; field-width: 96px; }
            CheckField { label: "Rank regression"; checked <=> LifeUi.rank; }
        }
        PrimaryButton {
            text: "Run fit";
            icon: @image-url("icons/play.svg");
            clicked => { Actions.act("life-fit"); }
        }
        CheckField { label: "Show probability plot"; checked <=> LifeUi.show-prob; }
        CsvImport { }
    }
    CenterPanel {
        if LifeUi.headline-value != "": HeadlineCard {
            label: "Reliability at mission time";
            value: LifeUi.headline-value;
        }
        if LifeUi.has-chart: ChartCard {
            chart: LifeUi.chart;
            title: LifeUi.chart-title;
        }
        if !LifeUi.has-chart: Rectangle {
            background: Theme.card;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border-soft;
            min-height: 200px;
            Text {
                text: "Run a fit to see the reliability curve here.";
                font-family: Theme.font;
                font-size: Theme.fs-body;
                color: Theme.faint;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            spacing: 8px;
            SectionTitle { text: "Distribution wizard"; }
            Caption { text: "Rank candidate distributions by AIC on the current life data."; }
            HorizontalLayout {
                spacing: 8px;
                GhostButton {
                    text: "Rank distributions";
                    icon: @image-url("icons/chart.svg");
                    clicked => { Actions.act("life-wizard"); }
                }
                Text {
                    text: LifeUi.wizard-note;
                    font-family: Theme.font;
                    font-size: Theme.fs-caption;
                    color: Theme.muted;
                    vertical-alignment: center;
                }
            }
            if LifeUi.wizard-rows.length > 0: Rectangle {
                background: Theme.card;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-soft;
                height: 264px;
                VerticalLayout {
                    padding: 8px;
                    spacing: 0;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        height: 26px;
                        Text { text: "Distribution"; font-family: Theme.font; font-size: 12px; font-weight: 600; color: Theme.muted; width: 30%; vertical-alignment: center; }
                        Text { text: "Loglik"; font-family: Theme.font; font-size: 12px; font-weight: 600; color: Theme.muted; width: 15%; vertical-alignment: center; }
                        Text { text: "AIC"; font-family: Theme.font; font-size: 12px; font-weight: 600; color: Theme.muted; width: 15%; vertical-alignment: center; }
                        Text { text: "BIC"; font-family: Theme.font; font-size: 12px; font-weight: 600; color: Theme.muted; width: 15%; vertical-alignment: center; }
                        Text { text: "AD"; font-family: Theme.font; font-size: 12px; font-weight: 600; color: Theme.muted; width: 10%; vertical-alignment: center; }
                        Text { text: ""; width: 15%; }
                    }
                    ListView {
                        for r[i] in LifeUi.wizard-rows: HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            height: 34px;
                            Text { text: r.label; font-family: Theme.font; font-size: 13px; color: Theme.text; width: 30%; vertical-alignment: center; overflow: elide; }
                            Text { text: r.loglik; font-family: Theme.font; font-size: 13px; color: Theme.text; width: 15%; vertical-alignment: center; }
                            Text { text: r.aic; font-family: Theme.font; font-size: 13px; color: Theme.text; width: 15%; vertical-alignment: center; }
                            Text { text: r.bic; font-family: Theme.font; font-size: 13px; color: Theme.text; width: 15%; vertical-alignment: center; }
                            Text { text: r.ad; font-family: Theme.font; font-size: 13px; color: Theme.text; width: 10%; vertical-alignment: center; }
                            HorizontalLayout {
                                width: 15%;
                                alignment: start;
                                if r.usable: GhostButton {
                                    text: "Use";
                                    height: 26px;
                                    clicked => { Actions.row-act("wizard-use", i); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    RightPanel {
        SectionTitle { text: "Results"; }
        for r in LifeUi.results: ResultCard {
            label: r.label;
            value: r.value;
        }
        if LifeUi.results.length == 0: Caption {
            text: "No results yet. Run the analysis to see results here.";
        }
        SectionTitle { text: "Send this fit"; }
        if LifeUi.has-fit: VerticalLayout {
            spacing: 10px;
            ComboField {
                label: "Target RBD item";
                options: LifeUi.rbd-targets;
                index <=> LifeUi.target-index;
                field-width: 250px;
                changed => { Actions.act("flow-target"); }
            }
            ComboField {
                label: "Block";
                options: LifeUi.block-names;
                index <=> LifeUi.block-index;
                field-width: 250px;
            }
            PrimaryButton {
                text: "Assign fit to RBD block";
                icon: @image-url("icons/link.svg");
                clicked => { Actions.act("flow-rbd"); }
            }
            GhostButton {
                text: "Send fit to QCP";
                icon: @image-url("icons/link.svg");
                clicked => { Actions.act("flow-qcp"); }
            }
            GhostButton {
                text: "Send fit to Prediction";
                icon: @image-url("icons/link.svg");
                clicked => { Actions.act("flow-pred"); }
            }
        }
        if !LifeUi.has-fit: Caption {
            text: "Run a fit first, then the send actions appear here.";
        }
    }
}

export component LimitedScreen inherits HorizontalLayout {
    spacing: 0;
    LeftPanel {
        ScreenTitle { title: "Limited Data"; sub: "Hierarchical shrinkage for small lots, with bias correction and conformal bounds."; }
        TextAreaField {
            label: "One lot per line, times comma separated (c = censored)";
            value <=> LimitedUi.groups;
            rows: 7;
        }
        PrimaryButton {
            text: "Run hierarchical fit";
            icon: @image-url("icons/play.svg");
            clicked => { Actions.act("limited-run"); }
        }
    }
    CenterPanel {
        SectionTitle { text: "Results"; }
        ScrollView {
            ResultCards { rows: LimitedUi.results; }
        }
    }
}

export component McmcScreen inherits HorizontalLayout {
    spacing: 0;
    LeftPanel {
        ScreenTitle { title: "Bayesian MCMC"; sub: "Adaptive Metropolis sampling with split R-hat and ESS diagnostics."; }
        TextAreaField {
            label: "Times (c = censored)";
            value <=> McmcUi.times;
            rows: 4;
        }
        ComboField {
            label: "Model";
            options: ["weibull2", "lognormal"];
            index <=> McmcUi.dist-index;
            field-width: 264px;
        }
        HorizontalLayout {
            spacing: 10px;
            Field { label: "Draws"; value <=> McmcUi.draws; field-width: 76px; }
            Field { label: "Warmup"; value <=> McmcUi.warmup; field-width: 76px; }
            Field { label: "Chains"; value <=> McmcUi.chains; field-width: 64px; }
        }
        HorizontalLayout {
            spacing: 10px;
            Field { label: "Seed"; value <=> McmcUi.seed; field-width: 76px; }
            Field { label: "Mission t"; value <=> McmcUi.t; field-width: 96px; }
        }
        PrimaryButton {
            text: "Run MCMC";
            icon: @image-url("icons/play.svg");
            clicked => { Actions.act("mcmc-run"); }
        }
        Caption { text: "Sampling runs on the seeded library sampler, so runs repeat exactly."; }
    }
    CenterPanel {
        if McmcUi.headline-value != "": HeadlineCard {
            label: "Posterior reliability";
            value: McmcUi.headline-value;
        }
        SectionTitle { text: "Posterior summary"; }
        ScrollView {
            ResultCards { rows: McmcUi.results; }
        }
    }
}
