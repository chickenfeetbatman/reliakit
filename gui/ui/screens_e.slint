import { Theme } from "theme.slint";
import { Actions, PredUi, DoeUi, FlowUi, MarkovUi, QcpUi } from "state.slint";
import { PrimaryButton, GhostButton, SectionTitle, Caption, Field, ComboField, TextAreaField, ResultCards, HeadlineCard, LeftPanel, CenterPanel, RightPanel, ScreenTitle, ChartCard } from "components.slint";
import { ScrollView, ListView, ComboBox, LineEdit } from "std-widgets.slint";

export component PredictionScreen inherits HorizontalLayout {
    spacing: 0;
    LeftPanel {
        ScreenTitle { title: "Prediction"; sub: "Parts-count prediction, MIL-HDBK-217F part stress, allocation, derating, and clean-room method shapes."; }
        SectionTitle { text: "Life model (from a Life Data fit)"; }
        Caption { text: "A fitted distribution sent from a Life Data item, or set by hand here."; }
        ComboField {
            label: "Distribution";
            options: ["weibull2", "weibull3", "lognormal", "normal", "exponential", "gamma", "gumbel", "loglogistic", "logistic", "gompertz", "gengamma", "weibull1", "exponential2", "mixed_weibull"];
            index <=> PredUi.life-dist-index;
            field-width: 264px;
        }
        Field { label: "Params"; value <=> PredUi.life-params; field-width: 264px; }
        HorizontalLayout {
            spacing: 10px;
            Field { label: "Mission t"; value <=> PredUi.life-t; field-width: 110px; }
            GhostButton {
                text: "Compute R(t)";
                clicked => { Actions.act("pred-life"); }
            }
        }
        Caption { text: PredUi.life-result; }
        ComboField {
            label: "Standard / source";
            options: ["Generic user data", "MIL-HDBK-217F library", "Local library file"];
            index <=> PredUi.source-index;
            field-width: 264px;
        }
        if PredUi.source-index == 0: VerticalLayout {
            spacing: 10px;
            SectionTitle { text: "Parts-count prediction"; }
            TextAreaField {
                label: "One part per line: name, base rate per million hours, quantity, stress factor, quality factor";
                value <=> PredUi.parts;
                rows: 5;
            }
            HorizontalLayout {
                spacing: 10px;
                Field { label: "Mission t (hours)"; value <=> PredUi.t; field-width: 130px; }
                PrimaryButton {
                    text: "Run prediction";
                    icon: @image-url("icons/play.svg");
                    clicked => { Actions.act("pred-run"); }
                }
            }
        }
        if PredUi.source-index == 2: VerticalLayout {
            spacing: 10px;
            SectionTitle { text: "Local component library CSV"; }
            Caption { text: "Format: name, base rate per million hours, quantity, stress factor, quality factor. Comment lines starting with # are skipped."; }
            Field { label: "Library CSV path"; value <=> PredUi.lib-path; field-width: 264px; }
            GhostButton {
                text: "Load library";
                clicked => { Actions.act("pred-lib-load"); }
            }
            Caption { text: PredUi.lib-note; }
            Field { label: "Mission t (hours)"; value <=> PredUi.t; field-width: 130px; }
        }
        if PredUi.source-index == 1: VerticalLayout {
            spacing: 10px;
            SectionTitle { text: "MIL-HDBK-217F part stress"; }
            ComboField {
                label: "Category file";
                options: ["capacitors.json", "circuit_breakers.json", "coils.json", "connections.json", "connector_sockets.json", "connectors.json", "elapsed_time_meters.json", "electronic_filters.json", "fuses.json", "interconnection_assemblies_pth.json", "miscellaneous_parts.json", "quartz_crystals.json", "relays_mechanical.json", "relays_solid_state.json", "resistors.json", "switches.json", "synchros_and_resolvers.json", "transformers.json"];
                index <=> PredUi.p217-file-index;
                field-width: 264px;
            }
            GhostButton {
                text: "Load category";
                clicked => { Actions.act("pred217-load"); }
            }
            Caption { text: PredUi.p217-category; }
        }
    }
    CenterPanel {
        if PredUi.source-index == 0: VerticalLayout {
            spacing: 12px;
            SectionTitle { text: "System prediction"; }
            ScrollView {
                ResultCards { rows: PredUi.parts-results; }
            }
        }
        if PredUi.source-index == 2: VerticalLayout {
            spacing: 12px;
            SectionTitle { text: "Library parts"; }
            Rectangle {
                background: Theme.card;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-soft;
                min-height: 160px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 5px;
                    if PredUi.lib-rows.length == 0: Text {
                        text: "Load a library CSV to list its parts here.";
                        font-family: Theme.font;
                        font-size: Theme.fs-caption;
                        color: Theme.faint;
                    }
                    for r in PredUi.lib-rows: HorizontalLayout {
                        spacing: 12px;
                        height: 24px;
                        Text { text: r.cells[0]; font-family: Theme.font; font-size: 13px; color: Theme.text; width: 40%; vertical-alignment: center; overflow: elide; }
                        Text { text: "Qty " + r.cells[1]; font-family: Theme.font; font-size: 13px; color: Theme.muted; width: 20%; vertical-alignment: center; }
                        Text { text: r.cells[2]; font-family: Theme.font; font-size: 13px; color: Theme.text; width: 40%; vertical-alignment: center; }
                    }
                }
            }
            SectionTitle { text: "System totals"; }
            ResultCards { rows: PredUi.lib-results; }
        }
        if PredUi.source-index == 1: VerticalLayout {
            spacing: 12px;
            SectionTitle { text: "Category inputs"; }
            if PredUi.p217-misc: VerticalLayout {
                spacing: 10px;
                Caption { text: "This category holds fixed rates. Pick a part and an environment; the rate shown is the fixed rate times pi_E."; }
                ComboField {
                    label: "Part";
                    options: PredUi.p217-part-options;
                    index <=> PredUi.p217-part-index;
                    field-width: 420px;
                }
                ComboField {
                    label: "Environment";
                    options: ["GB", "GF", "GM", "NS", "NU", "AIC", "CL"];
                    index <=> PredUi.p217-env-index;
                    field-width: 200px;
                }
            }
            if !PredUi.p217-misc: Rectangle {
                background: Theme.card;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-soft;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    for f in PredUi.p217-fields: HorizontalLayout {
                        spacing: 12px;
                        height: 32px;
                        Text {
                            text: f.label;
                            font-family: Theme.font;
                            font-size: 13px;
                            color: Theme.muted;
                            width: 44%;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if f.named: ComboBox {
                            width: 56%;
                            height: 32px;
                            model: f.options;
                            current-index: f.sel;
                            selected(v) => { Actions.field-changed("p217:" + f.key, v); }
                        }
                        if !f.named: LineEdit {
                            width: 56%;
                            height: 32px;
                            text: f.value;
                            edited(v) => { Actions.field-changed("p217:" + f.key, v); }
                        }
                    }
                    if PredUi.p217-fields.length == 0: Text {
                        text: "Load a category to see its inputs.";
                        font-family: Theme.font;
                        font-size: Theme.fs-caption;
                        color: Theme.faint;
                    }
                }
            }
            PrimaryButton {
                text: "Compute part failure rate";
                icon: @image-url("icons/play.svg");
                clicked => { Actions.act("pred217-compute"); }
            }
            SectionTitle { text: "Result"; }
            ResultCards { rows: PredUi.p217-results; }
        }
    }
    RightPanel {
        SectionTitle { text: "Reliability allocation"; }
        HorizontalLayout {
            spacing: 10px;
            Field { label: "System target R"; value <=> PredUi.alloc-target; field-width: 110px; }
            Field { label: "Subsystems n"; value <=> PredUi.alloc-n; field-width: 90px; }
        }
        Field { label: "Weights (weighted)"; value <=> PredUi.alloc-weights; field-width: 250px; }
        GhostButton {
            text: "Allocate";
            clicked => { Actions.act("pred-alloc"); }
        }
        ResultCards { rows: PredUi.alloc-results; }
        SectionTitle { text: "Derating check"; }
        Field { label: "Part"; value <=> PredUi.der-name; field-width: 250px; }
        HorizontalLayout {
            spacing: 10px;
            Field { label: "Operating"; value <=> PredUi.der-operating; field-width: 76px; }
            Field { label: "Rated"; value <=> PredUi.der-rated; field-width: 76px; }
            Field { label: "Max ratio"; value <=> PredUi.der-max; field-width: 76px; }
        }
        GhostButton {
            text: "Check derating";
            clicked => { Actions.act("pred-derate"); }
        }
        ResultCards { rows: PredUi.der-results; }
        SectionTitle { text: "Clean-room methods"; }
        Caption { text: "SR-332 style and 62380-style method shapes only. Every rate and factor is a value you supply; no standard table data is built in."; }
        HorizontalLayout {
            spacing: 10px;
            Field { label: "Generic rate"; value <=> PredUi.sr-generic; field-width: 76px; }
            Field { label: "pi_q"; value <=> PredUi.sr-pi-q; field-width: 76px; }
            Field { label: "pi_s"; value <=> PredUi.sr-pi-s; field-width: 76px; }
        }
        HorizontalLayout {
            spacing: 10px;
            Field { label: "Ea (eV)"; value <=> PredUi.sr-ea; field-width: 76px; }
            Field { label: "Use temp C"; value <=> PredUi.sr-temp; field-width: 76px; }
            Field { label: "Ref temp C"; value <=> PredUi.sr-ref-temp; field-width: 76px; }
        }
        HorizontalLayout {
            spacing: 10px;
            Field { label: "pi_e"; value <=> PredUi.sr-pi-e; field-width: 76px; }
        }
        TextAreaField { label: "Quantity, device rate lines"; value <=> PredUi.sr-qty-rate; rows: 2; }
        HorizontalLayout {
            spacing: 10px;
            Field { label: "M-II observed rate"; value <=> PredUi.sr-obs-rate; field-width: 118px; }
            Field { label: "pi_t target"; value <=> PredUi.sr-pit-tgt; field-width: 118px; }
        }
        HorizontalLayout {
            spacing: 10px;
            Field { label: "pi_t observed"; value <=> PredUi.sr-pit-obs; field-width: 118px; }
            Field { label: "pi_s observed"; value <=> PredUi.sr-pis-obs; field-width: 118px; }
        }
        HorizontalLayout {
            spacing: 10px;
            Field { label: "pi_s target"; value <=> PredUi.sr-pis-tgt; field-width: 118px; }
            Field { label: "CI failures"; value <=> PredUi.sr-ci-failures; field-width: 118px; }
        }
        HorizontalLayout {
            spacing: 10px;
            Field { label: "Exposure hours"; value <=> PredUi.sr-ci-exposure; field-width: 118px; }
            Field { label: "Confidence"; value <=> PredUi.sr-ci-conf; field-width: 118px; }
        }
        HorizontalLayout {
            spacing: 10px;
            Field { label: "M-III predicted"; value <=> PredUi.sr-m3-pred; field-width: 118px; }
            Field { label: "Pred weight"; value <=> PredUi.sr-m3-pw; field-width: 118px; }
        }
        HorizontalLayout {
            spacing: 10px;
            Field { label: "M-III observed"; value <=> PredUi.sr-m3-obs; field-width: 118px; }
            Field { label: "Obs weight"; value <=> PredUi.sr-m3-ow; field-width: 118px; }
        }
        PrimaryButton {
            text: "Run clean-room calculations";
            icon: @image-url("icons/play.svg");
            clicked => { Actions.act("pred-clean"); }
        }
        SectionTitle { text: "62380-style mission profile"; }
        Caption { text: "A mission profile framework with user supplied base rate and factors. It holds no IEC 62380 table data."; }
        HorizontalLayout {
            spacing: 10px;
            Field { label: "Base rate"; value <=> PredUi.mp-base; field-width: 76px; }
            Field { label: "Ea (eV)"; value <=> PredUi.mp-ea; field-width: 76px; }
            Field { label: "Ref temp C"; value <=> PredUi.mp-ref; field-width: 76px; }
        }
        Field { label: "Cycling factor per cycle"; value <=> PredUi.mp-cyc; field-width: 160px; }
        TextAreaField {
            label: "Phases, one per line: name, duration hours, temp C, cycles, dormant (1 or 0), dormant factor";
            value <=> PredUi.mp-phases;
            rows: 3;
        }
        GhostButton {
            text: "Compute mission profile rate";
            clicked => { Actions.act("pred-mission"); }
        }
        ResultCards { rows: PredUi.clean-results; }
    }
}

export component DoeScreen inherits HorizontalLayout {
    spacing: 0;
    LeftPanel {
        ScreenTitle { title: "Factorial DOE"; sub: "Two-level factorial analysis: effects and sums of squares in Yates order."; }
        Field { label: "Factors k"; value <=> DoeUi.k; field-width: 90px; }
        Field { label: "Responses y (2^k values, Yates order)"; value <=> DoeUi.y; field-width: 264px; }
        PrimaryButton {
            text: "Analyze";
            icon: @image-url("icons/play.svg");
            clicked => { Actions.act("doe-run"); }
        }
        Caption { text: "The library also builds fractional factorials, Plackett-Burman, Taguchi, and response surface designs; this panel runs the full 2^k analysis."; }
    }
    CenterPanel {
        SectionTitle { text: "Effects"; }
        ScrollView {
            ResultCards { rows: DoeUi.results; }
        }
    }
}

export component FlowchartScreen inherits HorizontalLayout {
    spacing: 0;
    LeftPanel {
        ScreenTitle { title: "Flowchart Simulation"; sub: "Monte Carlo simulation of a process network (RENO style)."; }
        TextAreaField {
            label: "Process network JSON";
            value <=> FlowUi.json;
            rows: 9;
        }
        HorizontalLayout {
            spacing: 10px;
            Field { label: "Simulations"; value <=> FlowUi.sims; field-width: 110px; }
            Field { label: "Seed"; value <=> FlowUi.seed; field-width: 90px; }
        }
        PrimaryButton {
            text: "Run simulation";
            icon: @image-url("icons/play.svg");
            clicked => { Actions.act("flow-run"); }
        }
    }
    CenterPanel {
        SectionTitle { text: "Results"; }
        ScrollView {
            ResultCards { rows: FlowUi.results; }
        }
    }
}

export component MarkovScreen inherits HorizontalLayout {
    spacing: 0;
    LeftPanel {
        ScreenTitle { title: "Markov Chain"; sub: "Steady state, mean time to absorption, and transient probabilities for a continuous-time chain."; }
        Caption { text: "Preset: two-unit parallel repairable system. The preset gives MTTF 650 hours from Both up. Add a repair transition out of System down for a non-trivial steady state."; }
        GhostButton {
            text: "Load two-unit preset";
            clicked => { Actions.act("mk-preset"); }
        }
        SectionTitle { text: "States"; }
        for s[i] in MarkovUi.states: HorizontalLayout {
            spacing: 8px;
            height: 30px;
            Text {
                text: s;
                font-family: Theme.font;
                font-size: Theme.fs-body;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            GhostButton {
                text: "Remove";
                height: 26px;
                clicked => { Actions.row-act("mk-del-state", i); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Field { label: "New state"; value <=> MarkovUi.new-state; field-width: 150px; }
            GhostButton {
                text: "Add state";
                icon: @image-url("icons/plus.svg");
                clicked => { Actions.act("mk-add-state"); }
            }
        }
        SectionTitle { text: "Compute"; }
        ComboField {
            label: "Start state";
            options: MarkovUi.states;
            index <=> MarkovUi.start-index;
            field-width: 264px;
        }
        ComboField {
            label: "Absorbing state (for MTTF)";
            options: MarkovUi.states;
            index <=> MarkovUi.absorbing-index;
            field-width: 264px;
        }
        Field { label: "Transient time"; value <=> MarkovUi.time; field-width: 110px; }
        PrimaryButton {
            text: "Compute Markov results";
            icon: @image-url("icons/play.svg");
            clicked => { Actions.act("mk-run"); }
        }
    }
    CenterPanel {
        if MarkovUi.has-chart: ChartCard { chart: MarkovUi.chart; title: "Transient probabilities"; }
        SectionTitle { text: "Transitions"; }
        Rectangle {
            background: Theme.card;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border-soft;
            height: 190px;
            VerticalLayout {
                padding: 8px;
                ListView {
                    for r[i] in MarkovUi.transitions: Rectangle {
                        height: 34px;
                        border-radius: 6px;
                        background: MarkovUi.sel-transition == i ? Theme.tint-soft : transparent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text { text: r.cells[0] + "  to  " + r.cells[1]; font-family: Theme.font; font-size: 13px; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Text { text: "rate " + r.cells[2] + " /h"; font-family: Theme.font; font-size: 13px; color: Theme.muted; vertical-alignment: center; }
                        }
                        TouchArea {
                            clicked => { Actions.row-act("mk-select", i); }
                        }
                    }
                }
                if MarkovUi.transitions.length == 0: Text {
                    text: "No transitions yet. Add one from the inspector panel.";
                    font-family: Theme.font;
                    font-size: Theme.fs-caption;
                    color: Theme.faint;
                    horizontal-alignment: center;
                }
            }
        }
        SectionTitle { text: "Results"; }
        ScrollView {
            ResultCards { rows: MarkovUi.results; }
        }
    }
    RightPanel {
        SectionTitle { text: "Transition inspector"; }
        if MarkovUi.sel-transition >= 0: VerticalLayout {
            spacing: 10px;
            Field { label: "From state"; value <=> MarkovUi.tr-from; field-width: 250px; }
            Field { label: "To state"; value <=> MarkovUi.tr-to; field-width: 250px; }
            Field { label: "Rate per hour"; value <=> MarkovUi.tr-rate; field-width: 140px; }
            GhostButton {
                text: "Apply edits";
                clicked => { Actions.act("mk-apply-trans"); }
            }
            GhostButton {
                text: "Remove transition";
                icon: @image-url("icons/trash.svg");
                clicked => { Actions.act("mk-del-trans"); }
            }
        }
        if MarkovUi.sel-transition < 0: Caption { text: "Select a transition to edit it here."; }
        GhostButton {
            text: "Add transition";
            icon: @image-url("icons/plus.svg");
            clicked => { Actions.act("mk-add-trans"); }
        }
    }
}

export component QcpScreen inherits HorizontalLayout {
    spacing: 0;
    LeftPanel {
        ScreenTitle { title: "QCP"; sub: "Quick calculation pad: reliability, hazard, mean life, and Bx life for any distribution."; }
        ComboField {
            label: "Distribution";
            options: ["weibull2", "weibull3", "lognormal", "normal", "exponential", "gamma", "gumbel", "loglogistic", "logistic", "gompertz", "gengamma", "weibull1", "exponential2", "mixed_weibull"];
            index <=> QcpUi.dist-index;
            field-width: 264px;
            changed => { Actions.act("qcp-dist"); }
        }
        SectionTitle { text: "Parameters"; }
        for f in QcpUi.params: HorizontalLayout {
            spacing: 10px;
            height: 34px;
            Text {
                text: f.label;
                font-family: Theme.font;
                font-size: Theme.fs-body;
                color: Theme.muted;
                width: 90px;
                vertical-alignment: center;
            }
            LineEdit {
                width: 140px;
                height: 32px;
                text: f.value;
                edited(v) => { Actions.field-changed("qcp:" + f.key, v); }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Field { label: "Mission t"; value <=> QcpUi.t; field-width: 110px; }
            Field { label: "Bx fraction"; value <=> QcpUi.bx; field-width: 90px; }
        }
        Caption { text: "Bx fraction 0.10 means B10 life."; }
        PrimaryButton {
            text: "Calculate";
            icon: @image-url("icons/play.svg");
            clicked => { Actions.act("qcp-run"); }
        }
    }
    CenterPanel {
        if QcpUi.headline-value != "": HeadlineCard {
            label: "Reliability";
            value: QcpUi.headline-value;
        }
        SectionTitle { text: "Results"; }
        ScrollView {
            ResultCards { rows: QcpUi.results; }
        }
    }
}
